# ==========================================
# Zaaz B API - Production Environment Config
# ==========================================

PORT=5000
NODE_ENV=production

# Hostinger MySQL Database URL:
# Replace with your Hostinger database user, password, and database name
DATABASE_URL="mysql://u123456789_zaazb:YourSecureDbPassword@127.0.0.1:3306/u123456789_zaazb"

# High-Entropy JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET="generate-a-secure-random-64-char-hex-key-here"
JWT_REFRESH_SECRET="generate-a-second-secure-random-64-char-hex-key-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Media Storage Configuration
# Set to "cloudinary" for production cloud storage or "local" for server disk
STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Allowed Client Origin (Your production domain)
CLIENT_URL="https://zaazb.com"

# Initial Admin Credentials (used once during prisma db seed)
DEFAULT_ADMIN_EMAIL="admin@zaazb.com"
DEFAULT_ADMIN_PASSWORD="ChangeMe@Production2026!"

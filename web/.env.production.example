# ==========================================
# Zaaz B Web - Production Environment Config
# ==========================================

# Production API Endpoint (routed via Nginx or subdomain)
# Example: https://zaazb.com/api/v1 or https://api.zaazb.com/api/v1
NEXT_PUBLIC_API_URL="https://zaazb.com/api/v1"

# Real-time WebSocket Endpoint
# Example: https://zaazb.com or https://api.zaazb.com
NEXT_PUBLIC_SOCKET_URL="https://zaazb.com"

# Web Client canonical URL
NEXT_PUBLIC_APP_URL="https://zaazb.com"

# Google OAuth Client ID (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
